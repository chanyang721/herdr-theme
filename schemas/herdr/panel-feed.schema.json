{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "herdr-theme/panel-feed.schema.json",
  "title": "Local panel display feed v1",
  "description": "Compatible envelope and optional display extensions. Other existing feed fields remain open; see docs/panel-feed.md.",
  "type": "object",
  "required": ["v", "at", "computers", "spaces"],
  "properties": {
    "v": {"const": 1},
    "at": {"type": ["string", "number"]},
    "computers": {"type": "array", "items": {"type": "object"}},
    "repo_activity": {"$ref": "#/$defs/repo_activity"},
    "repo_flow": {"$ref": "#/$defs/repo_activity"},
    "spaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}}, "role_group": {"$ref": "#/$defs/profession"}}
      }
    }
  },
  "$defs": {
    "repo_id": {"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"},
    "repo_display": {"type":"string","minLength":1,"maxLength":100},
    "repo_account": {
      "type":"object","additionalProperties":false,
      "required":["id","name","kind","connection","source"],
      "properties":{
        "id":{"$ref":"#/$defs/repo_id"},"name":{"$ref":"#/$defs/repo_display"},
        "kind":{"enum":["personal","company"]},
        "connection":{"enum":["connected","disconnected","unknown"]},
        "source":{"enum":["private_catalog","explicit_probe"]}
      },
      "allOf":[{"if":{"properties":{"source":{"const":"private_catalog"}}},"then":{"properties":{"connection":{"const":"unknown"}}}}]
    },
    "repository": {
      "type":"object","required":["id","account_id","namespace","name"],
      "properties":{
        "id":{"$ref":"#/$defs/repo_id"},"account_id":{"$ref":"#/$defs/repo_id"},
        "namespace":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9-]{0,38}(?![\\s\\S])","maxLength":39},
        "name":{"type":"string","pattern":"^(?!\\.+(?![\\s\\S]))[A-Za-z0-9_.-]{1,100}(?![\\s\\S])","maxLength":100},
        "private":{"type":"boolean"},"quiet":{"type":"boolean"},
        "flow":{"$ref":"#/$defs/repo_flow_stages"}
      }
    },
    "repo_stage": {
      "type":"object",
      "properties":{
        "state":{"enum":["unknown","none","waiting","running","succeeded","failed","offline"]},
        "detail":{"type":"string","maxLength":160},
        "sha":{"type":"string","pattern":"^[A-Fa-f0-9]{7,64}(?![\\s\\S])"}
      }
    },
    "repo_target": {
      "allOf":[{"$ref":"#/$defs/repo_stage"}],
      "type":"object",
      "properties":{
        "id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"},
        "name":{"type":"string","maxLength":80},
        "computer":{"type":"string","pattern":"^[A-Za-z0-9_-]{0,128}(?![\\s\\S])"},
        "environment":{"type":"string","maxLength":40}
      }
    },
    "repo_flow_stages": {
      "description":"Optional per-repository stages. A stage that was not observed is left out; unknown extra fields are ignored.",
      "type":"object",
      "properties":{
        "commit":{"type":"object","properties":{
          "issue":{"type":"string","maxLength":40},"title":{"type":"string","maxLength":160},
          "sha":{"type":"string","pattern":"^[A-Fa-f0-9]{7,64}(?![\\s\\S])"}}},
        "push":{"$ref":"#/$defs/repo_stage"},
        "ci":{"$ref":"#/$defs/repo_stage"},
        "cd":{"allOf":[{"$ref":"#/$defs/repo_stage"}],"type":"object","properties":{
          "targets":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/repo_target"}}}},
        "provider":{"type":"string","maxLength":40}
      }
    },
    "repo_binding": {
      "type":"object","additionalProperties":false,"required":["agent_id","repository_id","state"],
      "properties":{
        "agent_id":{"$ref":"#/$defs/repo_id"},
        "repository_id":{"anyOf":[{"$ref":"#/$defs/repo_id"},{"type":"null"}]},
        "state":{"enum":["cwd","local","unlinked","unknown"]}
      },
      "allOf":[{"if":{"properties":{"state":{"const":"cwd"}}},"then":{"properties":{"repository_id":{"$ref":"#/$defs/repo_id"}}},"else":{"properties":{"repository_id":{"type":"null"}}}}]
    },
    "repo_event": {
      "type":"object","additionalProperties":false,
      "required":["id","operation_id","machine_id","agent_id","repository_id","operation","phase","result","evidence","observed_at"],
      "properties":{
        "id":{"$ref":"#/$defs/repo_id"},"operation_id":{"$ref":"#/$defs/repo_id"},"machine_id":{"$ref":"#/$defs/repo_id"},
        "agent_id":{"anyOf":[{"$ref":"#/$defs/repo_id"},{"type":"null"}]},"repository_id":{"$ref":"#/$defs/repo_id"},
        "operation":{"enum":["commit","push","pull","merge","fetch","rebase","reset","checkout","switch","cherry-pick","revert","tag","branch","clone","add","rm","mv","stash","restore","clean","worktree","other"]},
        "phase":{"enum":["attempt","authorization","result"]},"result":{"enum":["unknown","succeeded","failed"]},
        "evidence":{"enum":["pre_tool","post_tool","approval","process_exit","head_verified","timeout","sensor_error"]},
        "observed_at":{"type":"integer","minimum":0,"maximum":8640000000000}
      },
      "oneOf":[
        {"properties":{"evidence":{"const":"pre_tool"},"phase":{"const":"attempt"},"result":{"const":"unknown"}}},
        {"properties":{"evidence":{"const":"post_tool"},"phase":{"const":"result"},"result":{"const":"unknown"}}},
        {"properties":{"evidence":{"const":"approval"},"phase":{"const":"authorization"},"result":{"const":"unknown"}}},
        {"properties":{"evidence":{"const":"process_exit"},"phase":{"const":"result"},"result":{"enum":["succeeded","failed"]}}},
        {"properties":{"evidence":{"const":"head_verified"},"operation":{"const":"merge"},"phase":{"const":"result"},"result":{"const":"succeeded"}}},
        {"properties":{"evidence":{"enum":["timeout","sensor_error"]},"phase":{"const":"result"},"result":{"const":"unknown"}}}
      ]
    },
    "repo_activity": {
      "type":"object","additionalProperties":false,"required":["schema","accounts","repositories","bindings","events","coverage"],
      "properties":{
        "schema":{"const":"repo_activity_v1"},
        "accounts":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/repo_account"}},
        "repositories":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/repository"}},
        "bindings":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/repo_binding"}},
        "events":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/repo_event"}},
        "coverage":{
          "type":"object","additionalProperties":false,"required":["state","sensor","live_connected","gaps"],
          "properties":{
            "state":{"enum":["gap","unknown"]},"sensor":{"enum":["opt_in_callback","unknown"]},"live_connected":{"type":"boolean"},
            "gaps":{"type":"array","maxItems":8,"items":{"type":"string","maxLength":48}}
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "properties": {"profession": {"$ref": "#/$defs/profession"}, "role_group": {"$ref": "#/$defs/profession"}, "coordinator": {"const": true}}
    },
    "profession": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\s\u0000-\u001f\u007f]+(?![\\s\\S])"},
        "label": {"type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[^\\s\u0000-\u001f\u007f](?:[^\u0000-\u001f\u007f]*[^\\s\u0000-\u001f\u007f])?(?![\\s\\S])"}
      }
    }
  }
}
