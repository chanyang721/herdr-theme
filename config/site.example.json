{
  "label_prefix": "local.herdr-sixfold",
  "state_dir": "~/Library/Application Support/HerdrSixfold",
  "reports_dir": "~/Documents/HerdrReports",
  "projects_dir": "~/Documents/HerdrProjects",
  "hub_space_ids": ["sp-your-share-workspace-id"],
