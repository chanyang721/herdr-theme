    "Project A": {
      "sources": [{"path": "~/work/projects/example/docs/ARCHITECTURE.md", "label": "전체 아키텍처"}],
      "folders": ["~/work/projects/example/docs", {"path": "~/Documents/HerdrReports", "match": ["project-a"]}]
    },
    "Project B": {
      "topics": [{"root": "~/Documents/HerdrReports", "suffix": "ProjectB_overview.md", "label": "전체 구조"}],
      "folders": [{"path": "~/Documents/HerdrReports", "match": ["project-b"]}]
    }
  }
}
