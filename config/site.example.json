  "workspaces": {
    "project a": {"icon": "flower", "color": "ansi5", "alert_color": "ansi6"},
    "project b": {"icon": "medical", "color": "ansi6", "alert_color": "ansi5"}
  },
  "slack": {
    "workspace_url": "https://example.slack.com",
    "user_names": {"U00000000": "Me"}
  },
