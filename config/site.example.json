{
  "label_prefix": "local.herdr-sixfold",
  "state_dir": "~/Library/Application Support/HerdrSixfold",
  "reports_dir": "~/Documents/HerdrReports",
  "projects_dir": "~/Documents/HerdrProjects",
  "hub_space_ids": ["sp-your-hub-workspace-id"],
  "fallback_space": "Hub",
  "pane_header_index": false,
  "fixed_space_names": ["Hub", "Project A", "Project B"],
  "model_presets": {"claude": {"quick": "your-fast-model", "deep": {"model": "your-large-model", "effort": "high"}}},
  "new_space_preset": "deep",
  "project_aliases": {"pa": "project a", "에이": "project a"},
  "workspaces": {
    "project a": {"icon": "flower", "color": "ansi5", "alert_color": "ansi6"},
    "project b": {"icon": "medical", "color": "ansi6", "alert_color": "ansi5"}
  },
  "slack": {
    "workspace_url": "https://example.slack.com",
    "team_id": "T00000000",
    "user_names": {"U00000000": "Me"}
  },
  "doc_tabs": {
    "Project A": {
      "sources": [{"path": "~/work/projects/example/docs/ARCHITECTURE.md", "label": "전체 아키텍처"}],
      "folders": ["~/work/projects/example/docs", {"path": "~/Documents/HerdrReports", "match": ["project-a"]}]
    },
    "Project B": {
      "topics": [{"root": "~/Documents/HerdrReports", "suffix": "ProjectB_overview.md", "label": "전체 구조"}],
      "folders": [{"path": "~/Documents/HerdrReports", "match": ["project-b"]}]
    }
  }
}
