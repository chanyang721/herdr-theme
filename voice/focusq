#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export HERDR_VOICE_ROOT="$HERE"
if [ -x "$HERE/herdr-theme" ]; then
    exec "$HERE/herdr-theme" focusq "$@"
fi
if [ -x "$HERE/../rust/target/release/herdr-theme" ]; then
    exec "$HERE/../rust/target/release/herdr-theme" focusq "$@"
fi
echo 'Build the native helper first: CARGO_BUILD_JOBS=1 cargo build --manifest-path rust/Cargo.toml --release' >&2
exit 1
