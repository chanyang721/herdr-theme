#!/usr/bin/env python3
"""focusq - install and toggle the herdr focus-queue plugin.

  ./focusq setup      everything at once: tools, plugin, F8 key, voice gate
                      (--enroll also records 45 s of your voice right away)
  ./focusq install    link the plugin and set Claude Code's voice key (F8, tap mode)
  ./focusq enable     turn the plugin on
  ./focusq disable    turn the plugin off (panes keep their current voice state)
  ./focusq status     show whether the plugin is linked and enabled
  ./focusq check      check that herdr, the submit hook, the app and Codex all run this copy
  ./focusq uninstall  unlink the plugin and remove the F8 voice binding

  ./focusq voice-setup   install the voice gate (install runs this when uv exists)
  ./focusq voice-enroll  enroll your voice for the current microphone (needed for auto-send)
  ./focusq voice-test    show live scores for each spoken segment
  ./focusq voice-off     forget the voiceprint (no auto-send until you enroll again)
  ./focusq voice-hook    add only the submit hook to Claude Code's settings (install does this too)
  ./focusq voice-crosscheck  check that your voice fails on other people's devices
"""
import glob
import json
import os
import shutil
import subprocess
import sys
import time

PLUGIN_ID = "local.focus-queue"
ROOT = os.path.dirname(os.path.realpath(__file__))
# HERDR_VOICE_NO_START=1 writes every file but starts nothing: no LaunchAgent,
# no model download (used for installs into a test home).
NO_START = os.environ.get("HERDR_VOICE_NO_START") == "1"
APP_HOME = os.environ.get("HERDR_APP_HOME") or os.path.expanduser("~/.config/herdr-app")
INTEGRATION = os.path.join(APP_HOME, "data", "sixfold", "voice-integration.json")
CLAUDE_DIR = os.path.expanduser("~/.claude")
SETTINGS = os.path.join(CLAUDE_DIR, "settings.json")
KEYBINDINGS = os.path.join(CLAUDE_DIR, "keybindings.json")
VOICE_KEY = "f8"
VOICE_HOME = os.path.expanduser("~/.local/share/herdr-focus-queue")
VOICE_PYTHON = os.path.join(VOICE_HOME, "venv", "bin", "python")
STATE_DIR = os.path.expanduser("~/.local/state/herdr/plugins/local.focus-queue")
VOICEPRINT = os.path.join(STATE_DIR, "voiceprint.json")
MODEL_URLS = [
    "https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/"
    "3dspeaker_speech_eres2net_base_sv_zh-cn_3dspeaker_16k.onnx",
    "https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/silero_vad.onnx",
]


def herdr(*args):
    binary = shutil.which("herdr")
    if not binary:
        sys.exit("herdr is not installed: brew install herdr")
    result = subprocess.run([binary, *args], capture_output=True, text=True)
    if result.returncode != 0:
        sys.exit(f"herdr {' '.join(args)} failed: {result.stderr.strip() or result.stdout.strip()}")
    try:
        return json.loads(result.stdout).get("result", {})
    except ValueError:
        return {}


def plugin():
    plugins = herdr("plugin", "list", "--json").get("plugins", [])
    return next((item for item in plugins if item.get("plugin_id") == PLUGIN_ID), None)


def edit_json(path, change):
    """Apply change() to a JSON file, keeping a timestamped backup."""
    data = {}
    if os.path.exists(path):
        with open(path) as handle:
            data = json.load(handle)
    before = json.dumps(data, sort_keys=True)
    change(data)
    if json.dumps(data, sort_keys=True) == before:
        return False
    if os.path.exists(path):
        shutil.copy2(path, f"{path}.focusq-{time.strftime('%Y%m%d%H%M%S')}.bak")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as handle:
        json.dump(data, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
    return True


def chat_bindings(data):
    blocks = data.setdefault("bindings", [])
    block = next((item for item in blocks if item.get("context") == "Chat"), None)
    if block is None:
        block = {"context": "Chat", "bindings": {}}
        blocks.append(block)
    return block.setdefault("bindings", {})


def set_voice(data):
    data["voiceEnabled"] = True
    data["voice"] = {**data.get("voice", {}), "enabled": True, "mode": "tap"}
    data.setdefault("language", "korean")


SUBMIT_HOOK = f"/usr/bin/python3 {os.path.join(ROOT, 'voice_submit_hook.py')}"


def submit_hooks(data):
    return data.setdefault("hooks", {}).setdefault("UserPromptSubmit", [])


def old_submit_hook(command):
    """A submit hook of this plugin installed from another folder."""
    return command != SUBMIT_HOOK and command.rstrip().endswith("/voice_submit_hook.py")


def set_submit_hook(data):
    """Every prompt passes voice_submit_hook.py, which refuses dictation the
    voice gate did not hear the user say. A hook left by an install from
    another folder is replaced in the same write, so no prompt goes unchecked
    and none is checked twice."""
    entries = submit_hooks(data)
    for entry in entries:
        entry["hooks"] = [hook for hook in entry.get("hooks", []) if not old_submit_hook(hook.get("command", ""))]
    entries[:] = [entry for entry in entries if entry.get("hooks")]
    if not any(hook.get("command") == SUBMIT_HOOK for entry in entries for hook in entry.get("hooks", [])):
        entries.append({"hooks": [{"type": "command", "command": SUBMIT_HOOK}]})


def remove_submit_hook(data):
    entries = submit_hooks(data)
    entries[:] = [entry for entry in entries
                  if not any(hook.get("command") == SUBMIT_HOOK for hook in entry.get("hooks", []))]


def set_integration(data):
    """The Herdr app's sidebar asks this script where focus went."""
    data["script"] = os.path.join(ROOT, "focus_queue.py")


def linked():
    current = plugin()
    return bool(current) and os.path.realpath(os.path.dirname(current.get("manifest_path", ""))) == ROOT


def install():
    # Relinking from another folder: events go to this copy from the next one.
    # Running listeners keep the code they started with until they end.
    current = plugin()
    # Moving an existing install keeps its choice about the submit hook: it is
    # repointed if it was there and not added if it was not. A new install adds it.
    try:
        commands = [hook.get("command", "") for entry in submit_hooks(json.load(open(SETTINGS)))
                    for hook in entry.get("hooks", [])]
    except (OSError, ValueError):
        commands = []
    want_hook = not current or any(command.rstrip().endswith("/voice_submit_hook.py") for command in commands)
    if current and not linked():
        herdr("plugin", "unlink", PLUGIN_ID)
    if not linked():
        herdr("plugin", "link", ROOT)
    # A new link is already enabled. Enabling needs a running herdr server,
    # which a fresh Mac does not have yet, so only ask when it is off.
    if not (plugin() or {}).get("enabled"):
        herdr("plugin", "enable", PLUGIN_ID)
    edit_json(SETTINGS, set_voice)
    if want_hook:
        edit_json(SETTINGS, set_submit_hook)
    else:
        print("submit hook left off as before: ./focusq voice-hook adds it")
    edit_json(KEYBINDINGS, lambda data: chat_bindings(data).__setitem__(VOICE_KEY, "voice:pushToTalk"))
    edit_json(INTEGRATION, set_integration)
    codex = [sys.executable, os.path.join(ROOT, "install_codex_focus.py")]
    subprocess.run(codex + (["--no-start"] if NO_START else []), check=True)
    print(f"installed from {ROOT}: plugin linked and enabled, Claude Code voice on F8 (tap mode)")
    if NO_START:
        print("voice check not set up (HERDR_VOICE_NO_START)")
    elif shutil.which("uv"):
        voice_setup()
    else:
        print("voice check skipped: install uv (brew install uv) and run ./focusq voice-setup")
    print("restart running Claude Code sessions to pick up the F8 voice key")


def check():
    """Whether every entry point runs this copy. Exit 1 lists what does not."""
    problems = []
    if not linked():
        problems.append(f"herdr plugin: {(plugin() or {}).get('manifest_path', 'not linked')}")
    try:
        settings = json.load(open(SETTINGS))
    except (OSError, ValueError):
        settings = {}
    commands = [hook.get("command", "") for entry in submit_hooks(settings) for hook in entry.get("hooks", [])]
    if any(old_submit_hook(command) for command in commands):
        problems.append(f"Claude submit hook: {[c for c in commands if c.endswith('voice_submit_hook.py')]}")
    elif SUBMIT_HOOK not in commands:
        print("note - Claude submit hook is off (./focusq voice-hook adds it)")
    try:
        script = json.load(open(INTEGRATION)).get("script")
    except (OSError, ValueError):
        script = None
    if script != os.path.join(ROOT, "focus_queue.py"):
        problems.append(f"app focus routing: {script}")
    sys.path.insert(0, ROOT)
    sys.dont_write_bytecode = True  # the installed copy stays free of __pycache__
    from install_codex_focus import label as codex_label
    agent = os.path.expanduser(f"~/Library/LaunchAgents/{codex_label(os.path.expanduser('~'))}.plist")
    try:
        import plistlib
        arguments = plistlib.load(open(agent, "rb")).get("ProgramArguments", [])
    except (OSError, ValueError):
        arguments = []
    if os.path.join(ROOT, "codex_focus.py") not in arguments:
        problems.append(f"Codex focus LaunchAgent: {arguments or 'missing'}")
    for problem in problems:
        print("not this copy - " + problem)
    if not problems:
        print(f"all voice entry points run {ROOT}")
    return not problems


def uninstall():
    subprocess.run([sys.executable, os.path.join(ROOT, "install_codex_focus.py"), "--uninstall"], check=True)
    if plugin():
        herdr("plugin", "unlink", PLUGIN_ID)
    edit_json(KEYBINDINGS, lambda data: chat_bindings(data).pop(VOICE_KEY, None))
    edit_json(SETTINGS, remove_submit_hook)
    print("uninstalled: plugin unlinked, F8 voice binding and submit hook removed (voice settings kept)")


def status():
    current = plugin()
    if not current:
        print("not installed: run ./focusq install")
        return
    state = "enabled" if current.get("enabled") else "disabled"
    print(f"{state}  {current.get('manifest_path')}")


def voice_setup():
    uv = shutil.which("uv")
    if not uv:
        sys.exit("uv is not installed: brew install uv")
    if not os.path.exists(VOICE_PYTHON):
        subprocess.run([uv, "venv", "-q", "--python", "3.12", os.path.dirname(os.path.dirname(VOICE_PYTHON))],
                       check=True)
    subprocess.run([uv, "pip", "install", "-q", "--python", VOICE_PYTHON, "numpy", "sounddevice", "sherpa-onnx"],
                   check=True)
    models = os.path.join(VOICE_HOME, "models")
    os.makedirs(models, exist_ok=True)
    for url in MODEL_URLS:
        target = os.path.join(models, url.rsplit("/", 1)[1])
        if not os.path.exists(target):
            subprocess.run(["curl", "-fsSL", "-o", target, url], check=True)
    print(f"voice check ready in {VOICE_HOME}: your voice is learned from the dictations you send")


def setup(enroll=False):
    """Install what is missing; the voice is then learned from sent dictations."""
    for tool in ("herdr", "uv"):
        if not shutil.which(tool):
            if not shutil.which("brew"):
                sys.exit(f"{tool} is not installed and Homebrew is missing: https://brew.sh")
            subprocess.run(["brew", "install", tool], check=True)
    install()  # also sets up the voice gate, now that uv is there
    if os.path.exists(VOICEPRINT):
        print("voice: already learned on this machine; it keeps learning from what you send")
    elif not enroll:
        print("voice: learned on this machine from the dictations you send. After about 30 s of them your")
        print("       voice is sent without the send word and other voices are not (./focusq setup --enroll to start now)")
    else:
        # Enrolling from a Claude pane would dictate the speech into that pane.
        print("\n목소리를 학습합니다. 에이전트가 없는 셸 pane 에서 실행 중이어야 합니다.")
        env = {**os.environ, "HERDR_PLUGIN_STATE_DIR": STATE_DIR}
        subprocess.run([VOICE_PYTHON, os.path.join(ROOT, "voicegate.py"), "enroll"], env=env, check=True)
        print("voice: voiceprint saved; it keeps learning from the dictations you send")


def voicegate(*args):
    if not os.path.exists(VOICE_PYTHON):
        sys.exit("run ./focusq voice-setup first")
    env = {**os.environ, "HERDR_PLUGIN_STATE_DIR": STATE_DIR}
    subprocess.run(["pkill", "-f", "voicegate.py serve"])  # reload the voiceprint on next use
    os.execve(VOICE_PYTHON, [VOICE_PYTHON, os.path.join(ROOT, "voicegate.py"), *args], env)


def voice_off():
    subprocess.run(["pkill", "-f", "voicegate.py serve"])
    for name in ("voiceprint*.json", "voice-segments.jsonl", "voice-pool*.jsonl", "voice-confirmed.jsonl"):
        for path in glob.glob(os.path.join(STATE_DIR, name)) + [os.path.join(STATE_DIR, "voiceprint.json")]:
            if os.path.lexists(path):
                os.remove(path)
    print("voiceprint removed: it is learned again from the dictations you send")


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "status"
    if command == "setup":
        setup(enroll="--enroll" in sys.argv[2:])
    elif command == "install":
        install()
    elif command == "uninstall":
        uninstall()
    elif command in ("enable", "disable"):
        if not plugin():
            sys.exit("not installed: run ./focusq install")
        herdr("plugin", command, PLUGIN_ID)
        status()
    elif command == "status":
        status()
    elif command == "check":
        sys.exit(0 if check() else 1)
    elif command == "voice-setup":
        voice_setup()
        print("now run ./focusq voice-enroll")
    elif command == "voice-enroll":
        voicegate("enroll", *sys.argv[2:])
    elif command == "voice-test":
        voicegate("tail")
    elif command == "voice-hook":
        changed = edit_json(SETTINGS, set_submit_hook)
        print(f"submit hook {'added to' if changed else 'already in'} {SETTINGS}: {SUBMIT_HOOK}")
    elif command == "voice-off":
        voice_off()
    elif command == "voice-crosscheck":
        if not os.path.exists(VOICE_PYTHON):
            sys.exit("run ./focusq voice-setup first")
        env = {**os.environ, "HERDR_PLUGIN_STATE_DIR": STATE_DIR}
        os.execve(VOICE_PYTHON, [VOICE_PYTHON, "-I", os.path.join(ROOT, "tests", "check_other_device.py")], env)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
